# Reference only: the application reads process environment variables, not this file.
# Saathi Phase0/1 (new service; legacy Home Agents configuration follows).
SAATHI_DATABASE_URL=sqlite:///data/saathi-demo.sqlite3
# Compose alternative: postgresql+psycopg://saathi:local-demo-only@127.0.0.1:54329/saathi
SAATHI_REDIS_URL=
SAATHI_MEDIA_ROOT=data/saathi-media
SAATHI_MEDIA_TTL_SECONDS=900
SAATHI_PROVIDER_CONFIG=config/providers.example.yaml
WHATSAPP_PRODUCTION_ELIGIBLE=false
SAATHI_LIVE_ACTIONS_ENABLED=false
SAATHI_LIVE_SPEECH_ENABLED=false
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
# Explicit model/voice IDs are required when future live speech is authorized.
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
ELEVENLABS_STT_MODEL=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_VOICE_ID=
# Never commit actual credentials. Restart the server after configuring variables.
# Public hosted application; actual production values belong in Secret Manager.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Local development defaults to fixtures. Hosted env.yaml selects railradar.
HOME_AGENT_TRAIN_PROVIDER=fixture
RAILRADAR_API_KEY=
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
# Optional separately hosted Indic speech services; see docs/integrations.md.
HOME_AGENT_ASR_URL=
HOME_AGENT_TTS_URL=
HOME_AGENT_SPEECH_KEY=
# Private Cloud Run browser endpoint; invoked with workload identity, never a public worker key.
HOME_AGENT_BROWSER_WORKER_URL=
