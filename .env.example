# Reference only: the application reads process environment variables, not this file.
# Never commit actual credentials. Restart the server after configuring variables.
# Public hosted application; actual production values belong in Secret Manager.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Local development defaults to fixtures. Hosted env.yaml selects railradar.
HOME_AGENT_TRAIN_PROVIDER=fixture
RAILRADAR_API_KEY=
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
# Optional separately hosted Indic speech services; see docs/integrations.md.
HOME_AGENT_ASR_URL=
HOME_AGENT_TTS_URL=
HOME_AGENT_SPEECH_KEY=
# Private Cloud Run browser endpoint; invoked with workload identity, never a public worker key.
HOME_AGENT_BROWSER_WORKER_URL=
